[gd_scene format=3]

[sub_resource type="Shader" id="EmberShader"]
code = "shader_type spatial;
render_mode unshaded;
varying float heat;
void vertex() {
    heat = 0.6 + 0.25 * sin(TIME * 19.0) + 0.15 * sin(TIME * 43.0);
    VERTEX *= 0.85 + 0.3 * heat;
}
void fragment() {
    ALBEDO = vec3(1.0, 0.18 + 0.57 * heat, 0.04) * 1.8;
}"

[sub_resource type="ShaderMaterial" id="EmberMaterial"]
